  "info": {
    "description": "Read-only metagame data served from precomputed rollups. Premium fields are gated by entitlement flags (X-Entitlements header until real auth lands) and appear locked, never hidden.",
    "title": "Metagame Read API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/{game}/{format}/archetypes/{archetype_id}": {
      "get": {
        "description": "S3 archetype detail: current share/winrate (free); weekly share +\nwinrate series over the requested window (premium).",
        "operationId": "archetype_detail_v1__game___format__archetypes__archetype_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "archetype_id",
            "required": true,
            "schema": {
              "title": "Archetype Id",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "game",
            "required": true,
            "schema": {
              "title": "Game",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "format",
            "required": true,
            "schema": {
              "title": "Format",
              "type": "string"
            }
          },
          {
            "description": "snapshot date; default: latest",
            "in": "query",
            "name": "as_of",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "snapshot date; default: latest",
              "title": "As Of"
            }
          },
          {
            "description": "series window",
            "in": "query",
            "name": "weeks",
            "required": false,
            "schema": {
              "default": 13,
              "description": "series window",
              "maximum": 52,
              "minimum": 1,
              "title": "Weeks",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "x-entitlements",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Entitlements"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchetypeDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Archetype Detail"
      }
    },
