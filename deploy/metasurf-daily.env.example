# M4 daily-ingestion environment (copy to metasurf-daily.env and edit).
# Every value has a safe default in code; set what your host needs.

# Postgres the pipeline reads/writes (see README "Setup").
DATABASE_URL=postgresql://metagame:metagame@localhost:5432/metagame

# Where live CacheItem JSON events are written (events.raw_ref is relative to
# this). For a combined historical+live deployment, point this AT the
# MTGODecklistCache clone so match_extract resolves every event under one root.
METASURF_CACHE_ROOT=/var/lib/metasurf/data/MTGODecklistCache

# Immutable raw-HTML archive (kept forever; parser improvements reprocess it).
METASURF_RAW_ROOT=/var/lib/metasurf/data/raw

# Run status + alert logs (soak monitor reads daily_status.jsonl here).
METASURF_STATE_DIR=/var/lib/metasurf/data/state

# Failure alerting: any shell command; the alert is piped to its stdin as
# "<subject>\n\n<body>". Unset -> alerts still go to stderr + alerts.jsonl.
# Examples (uncomment ONE and adapt):
# METASURF_ALERT_CMD=mail -s "MetaSurf ingestion alert" you@example.com
# METASURF_ALERT_CMD=curl -sS -X POST -d @- https://ntfy.sh/your-metasurf-topic
# METASURF_ALERT_CMD=curl -sS -X POST -H 'Content-type: application/json' -d "{\"text\": \"$(cat)\"}" "$SLACK_WEBHOOK_URL"

# Best-effort Melee scraper (plan §10 risk 2). Off by default; only turn on
# once a real Melee adapter (with captured fixtures) exists.
# METASURF_MELEE_ENABLED=0

# TopDeck.gg source (first-party, free API — validated 2026-07-08). Best-effort
# and off by default; set BOTH to enable. Full swiss pairings -> strong match
# signal. Attribution ("Data provided by TopDeck.gg") is REQUIRED on any surface
# using this data. Never blocks the MTGO pipeline. Keep the key out of version
# control (this file is an example; put the real key in your private env file).
# TOPDECK_API_KEY=your-key-here
# METASURF_TOPDECK_ENABLED=1

# Archetype label granularity. "variant" (default) surfaces the specific
# rule-file variants as their own archetypes under parent_id (e.g. Eldrazi ->
# Broodscale / Ramp Eldrazi / Black Eldrazi). "parent" is the V1-validated
# identity (variants collapse to their parent). NB: V1's F1 targets were
# measured at parent granularity — a variant-level validation pass is owed
# before variant labels are a validated claim.
# METASURF_ARCHETYPE_GRANULARITY=variant
